    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.2",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
