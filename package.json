{
  "name": "thet-fund-task-tracker",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm:dev --workspace client\" \"npm:dev --workspace server\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "test": "npm test --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "format": "prettier --write \"client/**/*.{ts,tsx,js,css,json,html}\" \"server/**/*.{ts,js,json,yaml}\" \"*.{js,mjs,cjs,json,md,yaml}\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx,js,css,json,html}\" \"server/**/*.{ts,js,json,yaml}\" \"*.{js,mjs,cjs,json,md,yaml}\"",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
