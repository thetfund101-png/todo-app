NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
WEEKLY_PLAN_EDITOR_EMAIL=infothetfund@gmail.com

# Runtime account: grant only SELECT, INSERT, UPDATE, DELETE on the app database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thet_fund_tasks
DB_USER=thet_app
DB_PASSWORD=test1234

# Separate account for schema migrations and first-admin seeding.
DB_MIGRATION_USER=thet_migrator
DB_MIGRATION_PASSWORD=admin123

# Generate independent, random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local demo seed account; replace credentials before deployment.
ADMIN_NAME=THET Fund Administrator
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=DemoFund!2026Admin
